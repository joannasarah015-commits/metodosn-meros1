      "source": [
        "#ingreso datos de entrada para los diferentes métodos a trabajar\n",
        "a = 4\n",
        "b = 4.5\n",
        "\n",
        "#guarda valores iniciales\n",
        "a0 = a\n",
        "b0 = b\n",
        "\n",
        "#guarda valores iniciales del error y del número de interaciones\n",
        "tol = 0.000001 #float(input(\"ingrese el valor de la tolerancia: \")\n",
        "nmax = 100 #float(input(\"ingrese el número máximo de interaciones: \")\n",
        "error = 100\n",
        "niter = 0"
      ],
      "metadata": {
